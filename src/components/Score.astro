---
import { formatScore, scoreLevel } from '../lib/format';

interface Props {
  score: number | null;
  size?: 'md' | 'lg';
}

const { score, size = 'md' } = Astro.props;
const level = scoreLevel(score);
const label = score == null ? 'Nav vērtējumu' : `Vērtējums ${formatScore(score)} no 5`;
---

<span class:list={['score', level, size === 'lg' && 'lg']} role="img" aria-label={label} title={label}>
  {score == null ? '—' : formatScore(score)}
</span>
