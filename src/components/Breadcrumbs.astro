---
import JsonLd from './JsonLd.astro';

interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;

// Same trail as schema.org BreadcrumbList; the last item is the current page.
const structured = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: new URL(item.href ?? Astro.url.pathname, Astro.url.origin).href,
  })),
};
---

<nav class="breadcrumbs" aria-label="Navigācija">
  <ol>
    {items.map((item, i) =>
      item.href && i < items.length - 1 ? (
        <li><a href={item.href}>{item.label}</a></li>
      ) : (
        <li aria-current={i === items.length - 1 ? 'page' : undefined}>{item.label}</li>
      ),
    )}
  </ol>
</nav>
<JsonLd data={structured} />
